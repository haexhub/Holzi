# Hermes — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Auth (mandatory in production)
# -----------------------------------------------------------------------------
# Generate once: `openssl rand -hex 32` (64 hex chars = 32 bytes).
# Treat this like an SSH key. Same token is used by all clients
# (Signal worker, Cline/Roo Code, web UI, haex-vault HaexChat).
HERMES_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Public deployment (Traefik + Let's Encrypt)
# -----------------------------------------------------------------------------
# Domain Hermes is reachable under. Used by Traefik router labels
# and ACME-HTTP-01 challenge.
HERMES_DOMAIN=hermes.example.com

# Contact e-mail for Let's Encrypt account.
LETSENCRYPT_EMAIL=you@example.com

# Docker network shared with the external Traefik on the host.
# Default `proxy` matches the convention most self-hosters already use.
# If you bring up the bundled Traefik (`--profile traefik`), set
# PROXY_NETWORK_EXTERNAL=false so Compose creates the network itself.
PROXY_NETWORK=proxy
PROXY_NETWORK_EXTERNAL=true

# -----------------------------------------------------------------------------
# Hermes-server runtime
# -----------------------------------------------------------------------------
HERMES_DB_PATH=/data/hermes.db

# AES-256-GCM master key for the `llm_credentials` ciphertext (64 hex chars
# = 32 bytes). Generate once: `openssl rand -hex 32`. MUST be identical
# to whatever the haex-claude-proxy sqlite-resolver reads — the proxy
# decrypts the active credential row in-process and a key mismatch turns
# every chat request into a 500. Leave empty only if no DB-backed
# credentials are configured (lifespan then falls back to env vars).
HERMES_SECRET_KEY=

# Upstream LLM endpoint. Anything OpenAI-compatible works:
#   http://haex-claude-proxy:8080         (Claude Max via the bundled proxy)
#   https://api.openai.com                (OpenAI direct — set HERMES_LLM_API_KEY)
#   https://openrouter.ai/api/v1          (multi-provider gateway)
#   http://ollama:11434/v1                (local Ollama)
#   http://litellm:4000                   (LiteLLM proxy to anything)
HERMES_LLM_URL=http://haex-claude-proxy:8080

# Sent as `Authorization: Bearer ...`. Leave empty for haex-claude-proxy
# (it uses the Claude Max OAuth token from `claude login`) or for local
# Ollama. Required for OpenAI / OpenRouter / Anthropic direct.
HERMES_LLM_API_KEY=

# Model id passed through to the upstream. Examples:
#   claude-opus-4-7        (Claude Max via haex-claude-proxy or Anthropic)
#   gpt-4o                 (OpenAI)
#   anthropic/claude-3.5-sonnet   (OpenRouter)
#   llama3.1               (Ollama)
HERMES_MODEL=claude-opus-4-7

# Log level: DEBUG | INFO | WARNING | ERROR
HERMES_LOG_LEVEL=INFO

# Path to a rotating JSON log file mirroring stdout. When unset, the
# Control Center's /settings/logs page reports 503 — set this (e.g.
# /var/log/hermes/agent.log) to enable the in-app log tail.
HERMES_LOG_FILE=
# Per-file rotation cap and how many backups to keep alongside the live
# file (.1, .2, …). Defaults are 10 MiB × 3 backups → ~40 MiB ceiling.
HERMES_LOG_FILE_MAX_BYTES=10485760
HERMES_LOG_FILE_BACKUP_COUNT=3

# -----------------------------------------------------------------------------
# External MCP servers (Phase post-MVP)
# -----------------------------------------------------------------------------
# JSON array of `{ "name": "...", "url": "...", "token": "..." }`.
# Empty list disables external MCP integration.
# Example: [{"name":"vault","url":"https://vault.example.com/mcp","token":"..."}]
HERMES_EXTERNAL_MCP=[]

# -----------------------------------------------------------------------------
# Optional: external API keys (Phase 7 tools)
# -----------------------------------------------------------------------------
# Brave Search API key. Used by the `web_search` MCP/agent tool. Get one
# at https://api.search.brave.com/. Leave empty to disable web search.
HERMES_BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Local dev-stack (docker-compose.local.yml only — ignored by the prod compose)
# -----------------------------------------------------------------------------
# Host-Port for the bundled Traefik. Default 80; override when something
# else already listens on 80 — URLs become http://hermes.localhost:<port>
# and http://app.localhost:<port>.
# HERMES_LOCAL_WEB_PORT=80

# Host-Port for the Traefik dashboard (debug UI for routes/middlewares).
# HERMES_LOCAL_DASHBOARD_PORT=11000

# Tag for the haex-claude-proxy image. Default `dev` matches what
# `make build` produces in the haex-claude-proxy repo. Prod uses pinned
# SHAs from a registry.
# HAEX_CLAUDE_PROXY_TAG=dev

# Host path of the container-control socket. The Makefile fills this in
# automatically from the detected runtime:
#   Docker:  /var/run/docker.sock
#   Podman:  $XDG_RUNTIME_DIR/podman/podman.sock  (e.g. /run/user/1000/podman/podman.sock)
# Override here only when running `docker compose` / `podman compose` by
# hand instead of through `make up-local{-full}`.
#
# NOTE: do NOT leave the line uncommented with an empty value — an empty
# env var defeats the Makefile's `?=` default. If you uncomment, fill it
# in with a real path.
# HERMES_CONTAINER_SOCKET=/var/run/docker.sock
